# .env — public client values only
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# .env.server — never imported by the app
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_me
APP_OWNER_EMAIL=owner@example.com
APP_OWNER_PASSWORD=replace_me
